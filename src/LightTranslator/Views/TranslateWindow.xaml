<Window x:Class="LightTranslator.Views.TranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="语桥"
        Icon="/Bridgo;component/Assets/AppIcon.ico"
        Width="520"
        Height="316"
        MinWidth="420"
        MinHeight="276"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Base}"
        AllowsTransparency="False"
        ShowInTaskbar="True"
        Topmost="True"
        FontFamily="{DynamicResource Font.Family.Primary}"
        Foreground="{DynamicResource Brush.Text.Primary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Bridgo;component/Resources/Styles/TitleBarButtons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <ControlTemplate
            x:Key="Template.Translate.SourceEditor"
            TargetType="TextBox">
            <Border
                x:Name="InputBorder"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="10">
                <ScrollViewer
                    x:Name="PART_ContentHost"
                    Focusable="False"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="InputBorder" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style
            x:Key="Style.Translate.SourceEditor"
            TargetType="TextBox">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Window.Base}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template" Value="{StaticResource Template.Translate.SourceEditor}"/>
        </Style>

        <Style
            x:Key="Style.Translate.ResultEditor"
            TargetType="TextBox"
            BasedOn="{StaticResource Style.Translate.SourceEditor}">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            ResizeBorderThickness="6"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border
        x:Name="TranslationSurface"
        Padding="16"
        Background="{DynamicResource Brush.Surface.Card}"
        BorderThickness="0"
        CornerRadius="0"
        MouseLeftButtonDown="OnTranslationSurfaceMouseLeftButtonDown">

        <Grid KeyboardNavigation.TabNavigation="Continue">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid
                x:Name="TranslationTitleBar"
                Grid.Row="0"
                Height="36">
                <Image
                    x:Name="TranslationAppIcon"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Stretch="Uniform"
                    automation:AutomationProperties.Name="语桥">
                    <Image.Source>
                        <BitmapImage
                            UriSource="/Bridgo;component/Assets/AppIcon.png"
                            CacheOption="OnLoad"/>
                    </Image.Source>
                </Image>

                <Button
                    x:Name="TranslationCloseButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource Style.Button.TitleBar}"
                    Content="×"
                    FontSize="20"
                    FontWeight="Light"
                    IsTabStop="False"
                    automation:AutomationProperties.Name="关闭"
                    Click="OnCloseButtonClick"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    Height="34"
                    Style="{DynamicResource Style.Input.ComboBox}"
                    SelectedValuePath="Tag"
                    SelectedValue="{Binding SourceLanguage}">
                    <ComboBoxItem Content="自动检测" Tag="auto"/>
                    <ComboBoxItem Content="中文" Tag="zh"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                    <ComboBoxItem Content="日本語" Tag="ja"/>
                </ComboBox>

                <Button
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{DynamicResource Style.Button.IconCircle}"
                    Content="⇄"
                    FontSize="14"
                    ToolTip="交换源语言和目标语言"
                    automation:AutomationProperties.Name="交换源语言和目标语言"
                    Click="OnSwapLanguagesClick"/>

                <ComboBox
                    Grid.Column="2"
                    Height="34"
                    Style="{DynamicResource Style.Input.ComboBox}"
                    SelectedValuePath="Tag"
                    SelectedValue="{Binding TargetLanguage}">
                    <ComboBoxItem Content="中文" Tag="zh"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                    <ComboBoxItem Content="日本語" Tag="ja"/>
                </ComboBox>
            </Grid>

            <Grid Grid.Row="2" Margin="0,8,0,8">
                <TextBox
                    x:Name="SourceTextBox"
                    Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    Style="{StaticResource Style.Translate.SourceEditor}"
                    automation:AutomationProperties.Name="待翻译文本"/>
            </Grid>

            <Border
                Grid.Row="3"
                Background="{DynamicResource Brush.Border.Subtle}"/>

            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock
                        Style="{DynamicResource Style.Text.Caption}"
                        Text="翻译结果"
                        VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,2,0,0">
                    <TextBox
                        x:Name="ResultTextBox"
                        Height="Auto"
                        Padding="2"
                        Text="{Binding TranslatedText, Mode=OneWay}"
                        IsReadOnly="True"
                        IsTabStop="False"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        BorderThickness="0"
                        Background="Transparent"
                        FontSize="15"
                        VerticalContentAlignment="Top"
                        Style="{StaticResource Style.Translate.ResultEditor}"
                        automation:AutomationProperties.Name="翻译结果"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="5">
                <Border
                    x:Name="ErrorStatusBorder"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="0,6,0,0"
                    Padding="8,4"
                    Background="{DynamicResource Brush.Surface.Elevated}"
                    BorderBrush="{DynamicResource Brush.Error}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock
                        Style="{DynamicResource Style.Text.Validation}"
                        Text="{Binding ErrorMessage}"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

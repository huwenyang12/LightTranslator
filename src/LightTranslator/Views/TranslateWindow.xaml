<Window x:Class="LightTranslator.Views.TranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="语桥"
        Width="540"
        Height="300"
        MinWidth="440"
        MinHeight="260"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Base}"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{DynamicResource Font.Family.Primary}"
        Foreground="{DynamicResource Brush.Text.Primary}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            ResizeBorderThickness="6"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border
        x:Name="TranslationSurface"
        Padding="18"
        Background="{DynamicResource Brush.Surface.Card}"
        BorderThickness="0"
        CornerRadius="0"
        MouseLeftButtonDown="OnTranslationSurfaceMouseLeftButtonDown">

        <Grid KeyboardNavigation.TabNavigation="Continue">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    Height="36"
                    Style="{DynamicResource Style.Input.ComboBox}"
                    SelectedValuePath="Tag"
                    SelectedValue="{Binding SourceLanguage}">
                    <ComboBoxItem Content="自动检测" Tag="auto"/>
                    <ComboBoxItem Content="中文" Tag="zh"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                    <ComboBoxItem Content="日本語" Tag="ja"/>
                </ComboBox>

                <Button
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{DynamicResource Style.Button.IconCircle}"
                    Content="⇄"
                    FontSize="15"
                    ToolTip="交换源语言和目标语言"
                    automation:AutomationProperties.Name="交换源语言和目标语言"
                    Click="OnSwapLanguagesClick"/>

                <ComboBox
                    Grid.Column="2"
                    Height="36"
                    Style="{DynamicResource Style.Input.ComboBox}"
                    SelectedValuePath="Tag"
                    SelectedValue="{Binding TargetLanguage}">
                    <ComboBoxItem Content="中文" Tag="zh"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                    <ComboBoxItem Content="日本語" Tag="ja"/>
                </ComboBox>
            </Grid>

            <TextBox
                x:Name="SourceTextBox"
                Grid.Row="1"
                Height="Auto"
                Margin="0,10,0,10"
                Padding="2"
                Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                BorderThickness="0"
                Background="Transparent"
                FontSize="16"
                VerticalContentAlignment="Top"
                Style="{DynamicResource Style.Input.TextBox}"
                automation:AutomationProperties.Name="待翻译文本"/>

            <Border
                Grid.Row="2"
                Background="{DynamicResource Brush.Border.Subtle}"/>

            <Grid Grid.Row="3" Margin="0,10,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock
                        Style="{DynamicResource Style.Text.Caption}"
                        Text="翻译结果"
                        VerticalAlignment="Center"/>

                    <Button
                        x:Name="CopyTranslationButton"
                        HorizontalAlignment="Right"
                        Height="30"
                        MinWidth="56"
                        Padding="10,0"
                        Style="{DynamicResource Style.Button.Quiet}"
                        Content="复制"
                        ToolTip="复制翻译结果"
                        automation:AutomationProperties.Name="复制翻译结果"
                        Click="OnCopyTranslationClick"/>
                </Grid>

                <TextBox
                    Grid.Row="1"
                    Height="Auto"
                    Margin="0,4,0,0"
                    Padding="2"
                    Text="{Binding TranslatedText, Mode=OneWay}"
                    IsReadOnly="True"
                    IsTabStop="False"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    BorderThickness="0"
                    Background="Transparent"
                    FontSize="16"
                    VerticalContentAlignment="Top"
                    Style="{DynamicResource Style.Input.TextBox}"
                    automation:AutomationProperties.Name="翻译结果"/>
            </Grid>

            <Grid Grid.Row="4">
                <Border
                    x:Name="ErrorStatusBorder"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Padding="8,4"
                    Background="{DynamicResource Brush.Surface.Elevated}"
                    BorderBrush="{DynamicResource Brush.Error}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock
                        Style="{DynamicResource Style.Text.Validation}"
                        Text="{Binding ErrorMessage}"/>
                </Border>

                <TextBlock
                    x:Name="KeyboardHintTextBlock"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{DynamicResource Style.Text.Caption}"
                    Text="Enter 复制 · Shift+Enter 换行 · Esc 关闭"/>
            </Grid>
        </Grid>
    </Border>
</Window>

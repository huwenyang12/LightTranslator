<Window x:Class="LightTranslator.Views.TranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="语桥"
        Width="520"
        Height="320"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True">

    <Border
        Background="#FFFFFF"
        CornerRadius="12"
        BorderBrush="#E5E7EB"
        BorderThickness="1">

        <Grid Margin="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- 语言栏 -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    Height="30"
                    SelectedValuePath="Tag"
                    SelectedValue="{Binding SourceLanguage}">
                    <ComboBoxItem Content="自动检测" Tag="auto"/>
                    <ComboBoxItem Content="中文" Tag="zh"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                    <ComboBoxItem Content="日本語" Tag="ja"/>
                </ComboBox>

                <Button
                    Grid.Column="1"
                    Width="30"
                    Height="30"
                    Content="⇄"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="16"
                    Click="OnSwapLanguagesClick"/>

                <ComboBox
                    Grid.Column="2"
                    Height="30"
                    SelectedValuePath="Tag"
                    SelectedValue="{Binding TargetLanguage}">
                    <ComboBoxItem Content="中文" Tag="zh"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                    <ComboBoxItem Content="日本語" Tag="ja"/>
                </ComboBox>

            </Grid>

            <!-- 输入 -->
            <TextBox
                x:Name="SourceTextBox"
                Grid.Row="1"
                Margin="0,8,0,8"
                Text="{Binding SourceText,
                               UpdateSourceTrigger=PropertyChanged}"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                BorderThickness="0"
                Background="Transparent"
                FontSize="16"
                VerticalContentAlignment="Top"/>

            <Border
                Grid.Row="2"
                Background="#E5E7EB"/>

            <!-- 翻译结果 -->
            <Grid Grid.Row="3">

                <TextBox
                    Margin="0,8,52,8"
                    Text="{Binding TranslatedText, Mode=OneWay}"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    BorderThickness="0"
                    Background="Transparent"
                    FontSize="16"
                    VerticalContentAlignment="Top"/>

                <Button
                    Width="44"
                    Height="26"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Content="复制"
                    Background="#F3F4F6"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    FontSize="12"
                    Click="OnCopyTranslationClick"/>

            </Grid>

            <!-- 状态栏 -->
            <Grid Grid.Row="4">

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#DC2626"
                    FontSize="12"
                    Text="{Binding ErrorMessage}"/>

                <TextBlock
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="#9CA3AF"
                    FontSize="11"
                    Text="Enter copy"/>

            </Grid>

        </Grid>

    </Border>
</Window>
<Window x:Class="LightTranslator.Views.ScreenshotCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Normal"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Cursor="Cross"
        FontFamily="{DynamicResource Font.Family.Primary}">

    <Grid>
        <Image
            x:Name="FrozenScreenImage"
            Stretch="Fill"
            IsHitTestVisible="False"/>

        <Canvas
            x:Name="CaptureCanvas"
            Background="#66000000"
            MouseLeftButtonDown="OnMouseLeftButtonDown"
            MouseMove="OnMouseMove"
            MouseLeftButtonUp="OnMouseLeftButtonUp">

            <Border
                x:Name="SelectionRectangle"
                BorderBrush="{DynamicResource Brush.Accent}"
                BorderThickness="2"
                Background="Transparent"
                CornerRadius="8"
                Visibility="Collapsed"
                IsHitTestVisible="False"/>

            <Border
                x:Name="SelectionDimensionPill"
                Padding="10,5"
                Background="{DynamicResource Brush.Surface.Elevated}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                <TextBlock
                    x:Name="SelectionDimensionTextBlock"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="0 × 0"/>
            </Border>
        </Canvas>

        <Border
            x:Name="CaptureInstructionPill"
            Margin="0,24,0,0"
            Padding="14,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{DynamicResource Brush.Surface.Elevated}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="14"
            IsHitTestVisible="False">
            <TextBlock
                Foreground="{DynamicResource Brush.Text.Primary}"
                FontSize="13"
                Text="拖动选择翻译区域 · Esc 取消"/>
        </Border>
    </Grid>
</Window>

<Window x:Class="LightTranslator.Views.ScreenshotTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图翻译"
        Width="600"
        Height="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Grid Background="#FF111827">

        <Image
            x:Name="FrozenSelectionImage"
            Stretch="Fill"/>

        <Canvas
            x:Name="TranslationCanvas"
            Background="Transparent"/>

        <Border
            x:Name="StatusBorder"
            Padding="18,12"
            CornerRadius="8"
            Background="#CC111827"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock
                x:Name="StatusTextBlock"
                Text="截图翻译正在准备…"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="White"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Visible"/>

        </Border>

    </Grid>

</Window>

<Window x:Class="LightTranslator.Views.ScreenshotTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图翻译"
        Width="600"
        Height="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Grid Background="{DynamicResource Brush.Window.Base}">

        <Image
            x:Name="FrozenSelectionImage"
            Stretch="Fill"/>

        <Canvas
            x:Name="TranslationCanvas"
            Background="Transparent"/>

        <Border
            x:Name="StatusBorder"
            Padding="16,12"
            CornerRadius="14"
            Background="{DynamicResource Brush.Surface.Elevated}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel>
                <ProgressBar
                    x:Name="StatusProgressBar"
                    Width="148"
                    Height="3"
                    Margin="0,0,0,10"
                    Background="{DynamicResource Brush.Border.Subtle}"
                    Foreground="{DynamicResource Brush.Accent}"
                    BorderThickness="0"
                    IsIndeterminate="True"
                    Visibility="Visible"/>

                <TextBlock
                    x:Name="StatusTextBlock"
                    MaxWidth="320"
                    Text="截图翻译正在准备…"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Visible"/>
            </StackPanel>

        </Border>

    </Grid>

</Window>

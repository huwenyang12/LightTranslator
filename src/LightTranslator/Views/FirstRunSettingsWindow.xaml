<Window x:Class="LightTranslator.Views.FirstRunSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title=""
        Icon="/Bridgo;component/Assets/AppIcon.ico"
        Width="520"
        Height="640"
        MinWidth="520"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        ShowInTaskbar="True"
        Background="{DynamicResource Brush.Window.Base}"
        FontFamily="{DynamicResource Font.Family.Primary}"
        Foreground="{DynamicResource Brush.Text.Primary}">

    <Window.Resources>
        <DataTemplate x:Key="LanguageOptionTemplate">
            <TextBlock Text="{Binding DisplayName}"/>
        </DataTemplate>

        <Style x:Key="Style.Settings.Title" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>

        <Style x:Key="Style.Settings.Section" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>

        <Style x:Key="Style.Settings.Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        </Style>

        <Style x:Key="Style.Settings.Card" TargetType="Border">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Faint}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="Style.Settings.TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonSurface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ButtonSurface"
                                    Property="Background"
                                    Value="{DynamicResource Brush.Surface.Elevated}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Style.Settings.SaveButton" TargetType="Button">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Opacity="0.90"/>
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.38"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Style.Settings.ScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border
                            x:Name="ThumbSurface"
                            MinHeight="20"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Opacity="0.28"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.50"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid KeyboardNavigation.TabNavigation="Continue">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid
            x:Name="SettingsTitleBar"
            Grid.Row="0"
            Height="36"
            Margin="16,8,16,0"
            MouseLeftButtonDown="OnSettingsTitleBarMouseLeftButtonDown">
            <Image
                x:Name="SettingsAppIcon"
                Width="20"
                Height="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Stretch="Uniform"
                automation:AutomationProperties.Name="语桥">
                <Image.Source>
                    <BitmapImage
                        UriSource="/Bridgo;component/Assets/AppIcon.png"
                        CacheOption="OnLoad"/>
                </Image.Source>
            </Image>

            <Button
                x:Name="SettingsCloseButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource Style.Settings.TitleBarButton}"
                Content="×"
                FontSize="20"
                FontWeight="Light"
                IsTabStop="False"
                ToolTip="关闭"
                automation:AutomationProperties.Name="关闭"
                Click="OnSettingsCloseButtonClick"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="20,6,20,14">
            <TextBlock
                x:Name="TitleTextBlock"
                Text="首次设置"
                Style="{StaticResource Style.Settings.Title}"/>
            <TextBlock
                Margin="0,3,0,0"
                Text="设置翻译服务、快捷键和常用偏好。"
                Style="{StaticResource Style.Settings.Caption}"/>
        </StackPanel>

        <ScrollViewer
            x:Name="SettingsScrollViewer"
            Grid.Row="2"
            Focusable="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}">
                    <Setter Property="Width" Value="4"/>
                    <Setter Property="Margin" Value="0,8,6,8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track
                                    x:Name="PART_Track"
                                    IsDirectionReversed="True"
                                    Minimum="{TemplateBinding Minimum}"
                                    Maximum="{TemplateBinding Maximum}"
                                    Value="{TemplateBinding Value}"
                                    ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton
                                            Command="{x:Static ScrollBar.PageUpCommand}"
                                            Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Style.Settings.ScrollThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton
                                            Command="{x:Static ScrollBar.PageDownCommand}"
                                            Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>

            <StackPanel Margin="20,0,20,16">

                <Border
                    x:Name="AccountSettingsCard"
                    Margin="0,0,0,10"
                    Padding="14"
                    Style="{StaticResource Style.Settings.Card}">
                    <StackPanel>
                        <TextBlock
                            Text="账户与 API"
                            Style="{StaticResource Style.Settings.Section}"/>
                        <TextBlock
                            Margin="0,3,0,10"
                            Text="API Key 仅加密保存在当前 Windows 用户下。"
                            Style="{StaticResource Style.Settings.Caption}"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Margin="0,0,0,6"
                            Text="DeepSeek API Key"
                            Style="{DynamicResource Style.Text.Body}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox
                                x:Name="ApiKeyPasswordBox"
                                Grid.Column="0"
                                Style="{DynamicResource Style.Input.PasswordBox}"
                                automation:AutomationProperties.Name="DeepSeek API Key"
                                PasswordChanged="OnApiKeyPasswordChanged"/>

                            <Button
                                x:Name="TestApiKeyButton"
                                Grid.Column="2"
                                Style="{DynamicResource Style.Button.Secondary}"
                                Content="测试连接"
                                IsEnabled="False"
                                automation:AutomationProperties.Name="测试 DeepSeek API 连接"
                                Click="OnTestApiKeyClick"/>
                        </Grid>

                        <TextBlock
                            x:Name="ApiKeyTestMessageTextBlock"
                            Margin="0,8,0,0"
                            Text=""
                            Style="{StaticResource Style.Settings.Caption}"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="TextTranslationSettingsCard"
                    Margin="0,0,0,10"
                    Padding="14"
                    Style="{StaticResource Style.Settings.Card}">
                    <StackPanel>
                        <TextBlock
                            Text="文本翻译"
                            Style="{StaticResource Style.Settings.Section}"/>
                        <TextBlock
                            Margin="0,3,0,10"
                            Text="唤起轻量翻译窗口的全局快捷键。"
                            Style="{StaticResource Style.Settings.Caption}"/>

                        <TextBlock
                            Margin="0,0,0,6"
                            Text="快捷键"
                            Style="{DynamicResource Style.Text.Body}"/>

                        <TextBox
                            x:Name="TextTranslationHotkeyBox"
                            Style="{DynamicResource Style.Input.TextBox}"
                            IsReadOnly="True"
                            automation:AutomationProperties.Name="文本翻译快捷键"
                            GotFocus="OnTextTranslationHotkeyBoxGotFocus"
                            PreviewKeyDown="OnTextTranslationHotkeyBoxPreviewKeyDown"/>

                        <TextBlock
                            x:Name="TextTranslationHotkeyErrorTextBlock"
                            Margin="0,8,0,0"
                            Text=""
                            Style="{DynamicResource Style.Text.Validation}"/>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="ScreenshotTranslationSettingsCard"
                    Margin="0,0,0,10"
                    Padding="14"
                    Style="{StaticResource Style.Settings.Card}">
                    <StackPanel>
                        <TextBlock
                            Text="截图翻译"
                            Style="{StaticResource Style.Settings.Section}"/>
                        <TextBlock
                            Margin="0,3,0,10"
                            Text="设置框选快捷键和默认翻译方向。"
                            Style="{StaticResource Style.Settings.Caption}"/>

                        <TextBlock
                            Margin="0,0,0,6"
                            Text="快捷键"
                            Style="{DynamicResource Style.Text.Body}"/>

                        <TextBox
                            x:Name="ScreenshotTranslationHotkeyBox"
                            Style="{DynamicResource Style.Input.TextBox}"
                            IsReadOnly="True"
                            automation:AutomationProperties.Name="截图翻译快捷键"
                            GotFocus="OnScreenshotTranslationHotkeyBoxGotFocus"
                            PreviewKeyDown="OnScreenshotTranslationHotkeyBoxPreviewKeyDown"/>

                        <TextBlock
                            x:Name="ScreenshotTranslationHotkeyErrorTextBlock"
                            Margin="0,8,0,12"
                            Text=""
                            Style="{DynamicResource Style.Text.Validation}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Text="源语言"
                                    Style="{DynamicResource Style.Text.Body}"/>
                                <ComboBox
                                    x:Name="ScreenshotSourceLanguageComboBox"
                                    Style="{DynamicResource Style.Input.ComboBox}"
                                    ItemTemplate="{StaticResource LanguageOptionTemplate}"
                                    ItemsSource="{Binding ScreenshotSourceLanguages}"
                                    SelectedValuePath="Code"
                                    automation:AutomationProperties.Name="截图翻译源语言"
                                    SelectedValue="{Binding ScreenshotSourceLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <Button
                                x:Name="ScreenshotLanguageSwapButton"
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Style="{DynamicResource Style.Button.IconCircle}"
                                Content="⇄"
                                FontSize="15"
                                ToolTip="交换源语言和目标语言"
                                automation:AutomationProperties.Name="交换截图翻译源语言和目标语言"
                                Click="OnScreenshotLanguageSwapClick"/>

                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Text="目标语言"
                                    Style="{DynamicResource Style.Text.Body}"/>
                                <ComboBox
                                    x:Name="ScreenshotTargetLanguageComboBox"
                                    Style="{DynamicResource Style.Input.ComboBox}"
                                    ItemTemplate="{StaticResource LanguageOptionTemplate}"
                                    ItemsSource="{Binding ScreenshotTargetLanguages}"
                                    SelectedValuePath="Code"
                                    automation:AutomationProperties.Name="截图翻译目标语言"
                                    SelectedValue="{Binding ScreenshotTargetLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="StartupSettingsCard"
                    Padding="14"
                    Style="{StaticResource Style.Settings.Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                Text="系统启动"
                                Style="{StaticResource Style.Settings.Section}"/>
                            <TextBlock
                                Margin="0,4,16,0"
                                Text="登录 Windows 后在后台启动语桥。"
                                Style="{StaticResource Style.Settings.Caption}"/>
                        </StackPanel>

                        <CheckBox
                            x:Name="StartWithWindowsCheckBox"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{DynamicResource Style.Input.CheckBox}"
                            automation:AutomationProperties.Name="登录 Windows 后启动语桥"
                            IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="3"
            Padding="20,8"
            Background="{DynamicResource Brush.Surface.Card}"
            BorderBrush="{DynamicResource Brush.Border.Faint}"
            BorderThickness="0,1,0,0">
            <Button
                x:Name="SaveButton"
                HorizontalAlignment="Right"
                Style="{StaticResource Style.Settings.SaveButton}"
                Content="保存"
                IsEnabled="False"
                automation:AutomationProperties.Name="保存设置"
                Click="OnSaveClick"/>
        </Border>
    </Grid>
</Window>

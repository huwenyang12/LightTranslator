<Window x:Class="LightTranslator.Views.FirstRunSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title=""
        Icon="/Bridgo;component/Assets/AppIcon.ico"
        Width="540"
        Height="680"
        MinWidth="540"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Brush.Window.Base}"
        FontFamily="{DynamicResource Font.Family.Primary}"
        Foreground="{DynamicResource Brush.Text.Primary}">

    <Window.Resources>
        <DataTemplate x:Key="LanguageOptionTemplate">
            <TextBlock Text="{Binding DisplayName}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid KeyboardNavigation.TabNavigation="Continue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,20,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border
                Width="46"
                Height="46"
                Background="{DynamicResource Brush.Surface.Elevated}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="14">
                <Image
                    x:Name="SettingsAppIcon"
                    Width="34"
                    Height="34"
                    Stretch="Uniform">
                    <Image.Source>
                        <BitmapImage
                            UriSource="/Bridgo;component/Assets/AppIcon.png"
                            CacheOption="OnLoad"/>
                    </Image.Source>
                </Image>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock
                    Text="语桥 Bridgo"
                    Style="{DynamicResource Style.Text.Caption}"/>
                <TextBlock
                    x:Name="TitleTextBlock"
                    Margin="0,2,0,0"
                    Text="首次设置"
                    Style="{DynamicResource Style.Text.Display}"/>
                <TextBlock
                    Margin="0,4,0,0"
                    Text="设置翻译服务、快捷键和常用偏好。"
                    Style="{DynamicResource Style.Text.Caption}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,20">

                <Border
                    x:Name="AccountSettingsCard"
                    Margin="0,0,0,12"
                    Padding="16"
                    Style="{DynamicResource Style.Surface.Card}">
                    <StackPanel>
                        <TextBlock
                            Text="账户与 API"
                            Style="{DynamicResource Style.Text.Section}"/>
                        <TextBlock
                            Margin="0,4,0,14"
                            Text="API Key 仅加密保存在当前 Windows 用户下。"
                            Style="{DynamicResource Style.Text.Caption}"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Margin="0,0,0,6"
                            Text="DeepSeek API Key"
                            Style="{DynamicResource Style.Text.Body}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox
                                x:Name="ApiKeyPasswordBox"
                                Grid.Column="0"
                                Style="{DynamicResource Style.Input.PasswordBox}"
                                automation:AutomationProperties.Name="DeepSeek API Key"
                                PasswordChanged="OnApiKeyPasswordChanged"/>

                            <Button
                                x:Name="TestApiKeyButton"
                                Grid.Column="2"
                                Style="{DynamicResource Style.Button.Secondary}"
                                Content="测试连接"
                                IsEnabled="False"
                                automation:AutomationProperties.Name="测试 DeepSeek API 连接"
                                Click="OnTestApiKeyClick"/>
                        </Grid>

                        <TextBlock
                            x:Name="ApiKeyTestMessageTextBlock"
                            Margin="0,8,0,0"
                            Text=""
                            Style="{DynamicResource Style.Text.Caption}"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="TextTranslationSettingsCard"
                    Margin="0,0,0,12"
                    Padding="16"
                    Style="{DynamicResource Style.Surface.Card}">
                    <StackPanel>
                        <TextBlock
                            Text="文本翻译"
                            Style="{DynamicResource Style.Text.Section}"/>
                        <TextBlock
                            Margin="0,4,0,14"
                            Text="唤起轻量翻译窗口的全局快捷键。"
                            Style="{DynamicResource Style.Text.Caption}"/>

                        <TextBlock
                            Margin="0,0,0,6"
                            Text="快捷键"
                            Style="{DynamicResource Style.Text.Body}"/>

                        <TextBox
                            x:Name="TextTranslationHotkeyBox"
                            Style="{DynamicResource Style.Input.TextBox}"
                            IsReadOnly="True"
                            automation:AutomationProperties.Name="文本翻译快捷键"
                            GotFocus="OnTextTranslationHotkeyBoxGotFocus"
                            PreviewKeyDown="OnTextTranslationHotkeyBoxPreviewKeyDown"/>

                        <TextBlock
                            x:Name="TextTranslationHotkeyErrorTextBlock"
                            Margin="0,8,0,0"
                            Text=""
                            Style="{DynamicResource Style.Text.Validation}"/>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="ScreenshotTranslationSettingsCard"
                    Margin="0,0,0,12"
                    Padding="16"
                    Style="{DynamicResource Style.Surface.Card}">
                    <StackPanel>
                        <TextBlock
                            Text="截图翻译"
                            Style="{DynamicResource Style.Text.Section}"/>
                        <TextBlock
                            Margin="0,4,0,14"
                            Text="设置框选快捷键和默认翻译方向。"
                            Style="{DynamicResource Style.Text.Caption}"/>

                        <TextBlock
                            Margin="0,0,0,6"
                            Text="快捷键"
                            Style="{DynamicResource Style.Text.Body}"/>

                        <TextBox
                            x:Name="ScreenshotTranslationHotkeyBox"
                            Style="{DynamicResource Style.Input.TextBox}"
                            IsReadOnly="True"
                            automation:AutomationProperties.Name="截图翻译快捷键"
                            GotFocus="OnScreenshotTranslationHotkeyBoxGotFocus"
                            PreviewKeyDown="OnScreenshotTranslationHotkeyBoxPreviewKeyDown"/>

                        <TextBlock
                            x:Name="ScreenshotTranslationHotkeyErrorTextBlock"
                            Margin="0,8,0,12"
                            Text=""
                            Style="{DynamicResource Style.Text.Validation}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Text="源语言"
                                    Style="{DynamicResource Style.Text.Body}"/>
                                <ComboBox
                                    x:Name="ScreenshotSourceLanguageComboBox"
                                    Style="{DynamicResource Style.Input.ComboBox}"
                                    ItemTemplate="{StaticResource LanguageOptionTemplate}"
                                    ItemsSource="{Binding ScreenshotSourceLanguages}"
                                    SelectedValuePath="Code"
                                    automation:AutomationProperties.Name="截图翻译源语言"
                                    SelectedValue="{Binding ScreenshotSourceLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <Button
                                x:Name="ScreenshotLanguageSwapButton"
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Style="{DynamicResource Style.Button.IconCircle}"
                                Content="⇄"
                                FontSize="15"
                                ToolTip="交换源语言和目标语言"
                                automation:AutomationProperties.Name="交换截图翻译源语言和目标语言"
                                Click="OnScreenshotLanguageSwapClick"/>

                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    Text="目标语言"
                                    Style="{DynamicResource Style.Text.Body}"/>
                                <ComboBox
                                    x:Name="ScreenshotTargetLanguageComboBox"
                                    Style="{DynamicResource Style.Input.ComboBox}"
                                    ItemTemplate="{StaticResource LanguageOptionTemplate}"
                                    ItemsSource="{Binding ScreenshotTargetLanguages}"
                                    SelectedValuePath="Code"
                                    automation:AutomationProperties.Name="截图翻译目标语言"
                                    SelectedValue="{Binding ScreenshotTargetLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="StartupSettingsCard"
                    Padding="16"
                    Style="{DynamicResource Style.Surface.Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                Text="系统启动"
                                Style="{DynamicResource Style.Text.Section}"/>
                            <TextBlock
                                Margin="0,4,16,0"
                                Text="登录 Windows 后在后台启动语桥。"
                                Style="{DynamicResource Style.Text.Caption}"/>
                        </StackPanel>

                        <CheckBox
                            x:Name="StartWithWindowsCheckBox"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{DynamicResource Style.Input.CheckBox}"
                            automation:AutomationProperties.Name="登录 Windows 后启动语桥"
                            IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="24,12"
            Background="{DynamicResource Brush.Surface.Card}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="0,1,0,0">
            <Button
                x:Name="SaveButton"
                Width="88"
                HorizontalAlignment="Right"
                Style="{DynamicResource Style.Button.Primary}"
                Content="保存"
                IsEnabled="False"
                automation:AutomationProperties.Name="保存设置"
                Click="OnSaveClick"/>
        </Border>
    </Grid>
</Window>

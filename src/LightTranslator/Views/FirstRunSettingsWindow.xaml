<Window x:Class="LightTranslator.Views.FirstRunSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LightTranslator"
        Icon="/LightTranslator;component/Assets/AppIcon.ico"
        Width="460"
        Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock"
                   Grid.Row="0"
                   Text="首次设置"
                   FontSize="24"
                   FontWeight="SemiBold"/>

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   Text="配置 DeepSeek API Key，完成后应用将在后台运行。"
                   Foreground="#666666"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="3"
                   Text="DeepSeek API Key"
                   FontWeight="SemiBold"/>

        <Grid Grid.Row="4"
              Margin="0,8,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>

            <PasswordBox x:Name="ApiKeyPasswordBox"
                         Grid.Column="0"
                         Height="36"
                         Padding="8,5"
                         PasswordChanged="OnApiKeyPasswordChanged"/>

            <Button x:Name="TestApiKeyButton"
                    Grid.Column="2"
                    Height="36"
                    Content="测试连接"
                    IsEnabled="False"
                    Click="OnTestApiKeyClick"/>

        </Grid>

        <TextBlock x:Name="ApiKeyTestMessageTextBlock"
                   Grid.Row="5"
                   Margin="0,6,0,0"
                   FontSize="12"
                   Foreground="#666666"
                   Text=""/>

        <StackPanel Grid.Row="6">

            <TextBlock Text="文本翻译快捷键"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="TextTranslationHotkeyBox"
                     Height="36"
                     Padding="8,5"
                     Margin="0,0,0,6"
                     IsReadOnly="True"
                     GotFocus="OnTextTranslationHotkeyBoxGotFocus"
                     PreviewKeyDown="OnTextTranslationHotkeyBoxPreviewKeyDown"/>

            <TextBlock x:Name="TextTranslationHotkeyErrorTextBlock"
                       Margin="0,0,0,6"
                       FontSize="12"
                       Foreground="#D32F2F"
                       Text=""/>

            <CheckBox x:Name="StartWithWindowsCheckBox"
                      Content="开机自动启动"
                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>

        </StackPanel>

        <StackPanel Grid.Row="8">
            <TextBlock Text="截图翻译"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock Text="截图翻译快捷键"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="ScreenshotTranslationHotkeyBox"
                     Height="36"
                     Padding="8,5"
                     Margin="0,0,0,6"
                     IsReadOnly="True"
                     GotFocus="OnScreenshotTranslationHotkeyBoxGotFocus"
                     PreviewKeyDown="OnScreenshotTranslationHotkeyBoxPreviewKeyDown"/>

            <TextBlock x:Name="ScreenshotTranslationHotkeyErrorTextBlock"
                       Margin="0,0,0,10"
                       FontSize="12"
                       Foreground="#D32F2F"
                       Text=""/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="源语言"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="ScreenshotSourceLanguageComboBox"
                              Height="36"
                              ItemsSource="{Binding ScreenshotSourceLanguages}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding ScreenshotSourceLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="目标语言"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="ScreenshotTargetLanguageComboBox"
                              Height="36"
                              ItemsSource="{Binding ScreenshotTargetLanguages}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding ScreenshotTargetLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Button x:Name="SaveButton"
                Grid.Row="10"
                Width="70"
                Height="36"
                HorizontalAlignment="Right"
                Content="保存"
                IsEnabled="False"
                Click="OnSaveClick"/>
    </Grid>
</Window>

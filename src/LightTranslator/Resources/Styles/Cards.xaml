<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Style.Surface.Card" TargetType="Border">
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.14}"/>
    </Style>

    <Style x:Key="Style.Surface.Status" TargetType="Border">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.8}"/>
    </Style>

    <Style x:Key="Style.Surface.KeyCap" TargetType="Border">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.8}"/>
    </Style>

    <Style x:Key="Style.Text.Validation" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Primary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
</ResourceDictionary>

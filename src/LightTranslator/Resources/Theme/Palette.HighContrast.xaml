<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Window.Base" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{x:Static SystemColors.GrayTextColor}"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{x:Static SystemColors.HighlightTextColor}"/>
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="Brush.Border.Faint" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{x:Static SystemColors.HotTrackColor}"/>
    <SolidColorBrush x:Key="Brush.Selection.Selected" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="Brush.Selection.Hover" Color="{x:Static SystemColors.ControlDarkColor}"/>
    <SolidColorBrush x:Key="Brush.Error" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="Brush.Focus" Color="{x:Static SystemColors.HighlightColor}"/>
</ResourceDictionary>

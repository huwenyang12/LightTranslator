<Window x:Class="LightTranslator.Services.Tray.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="语桥菜单"
        Width="180"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0"
        FontFamily="{DynamicResource Font.Family.Primary}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <Style x:Key="Style.TrayMenu.Command" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CommandSurface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Window.Base}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Window.Base}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CommandSurface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Style.TrayMenu.Separator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="14,4"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}"/>
        </Style>
    </Window.Resources>

    <Border
        x:Name="MenuSurface"
        Margin="10"
        Padding="4"
        Background="{DynamicResource Brush.Surface.Elevated}"
        BorderBrush="{DynamicResource Brush.Border.Subtle}"
        BorderThickness="1"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="18"
                ShadowDepth="4"
                Direction="270"
                Opacity="0.18"
                Color="Black"/>
        </Border.Effect>

        <StackPanel
            x:Name="CommandPanel"
            KeyboardNavigation.DirectionalNavigation="Cycle"
            KeyboardNavigation.TabNavigation="Cycle">
            <Button
                x:Name="TextTranslationButton"
                Style="{StaticResource Style.TrayMenu.Command}"
                Content="文本翻译"
                automation:AutomationProperties.Name="文本翻译"
                Click="OnTextTranslationClick"/>
            <Button
                x:Name="ScreenshotTranslationButton"
                Style="{StaticResource Style.TrayMenu.Command}"
                Content="截图翻译"
                automation:AutomationProperties.Name="截图翻译"
                Click="OnScreenshotTranslationClick"/>
            <Border Style="{StaticResource Style.TrayMenu.Separator}"/>
            <Button
                x:Name="SettingsButton"
                Style="{StaticResource Style.TrayMenu.Command}"
                Content="设置"
                automation:AutomationProperties.Name="设置"
                Click="OnSettingsClick"/>
            <Border Style="{StaticResource Style.TrayMenu.Separator}"/>
            <Button
                x:Name="ExitButton"
                Style="{StaticResource Style.TrayMenu.Command}"
                Content="退出"
                automation:AutomationProperties.Name="退出语桥"
                Click="OnExitClick"/>
        </StackPanel>
    </Border>
</Window>
